# Every environment variable the server reads, checked at start-up by lib/env.ts.
# No values here: npm run setup copies this file to .env.local. Uncomment a key to set it.
# Each backend task adds its own keys here and in lib/env.ts.

# development | test | production. Set by Next.js and Vitest; don't set it in .env files.
# NODE_ENV=

# "true" or "false" (default false). Demo sign-in, development only (AU-09). Put it in .env.development.local
# (`npm run setup` does), which only `next dev` reads, so production builds never see it.
# The app refuses to start with "true" when NODE_ENV=production.
# ENABLE_DEMO_LOGIN=

# Background worker (B06): how many jobs of one queue it runs at the same time, 1 to 20. Default: 2.
# The worker reads every other setting here too (DATABASE_URL, LOG_LEVEL, ...).
# WORKER_CONCURRENCY=

# Required in production (B07). The worker uses it to ask the web app to refresh its cached catalogue after an
# unpaid order's stock comes back; both processes need the same value, at least 32 random characters.
# `npm run setup` writes a random one for local use. Generate one with: openssl rand -base64 32
# Without it (development only), that refresh is skipped and shop pages catch up within a few hours.
# CACHE_REFRESH_SECRET=

# Where the worker reaches the web app (B07), e.g. http://web:3000 inside Docker. Default: SITE_URL.
# INTERNAL_APP_URL=

# fatal | error | warn | info | debug | trace | silent. Default: info (silent under tests) (OPS-01).
# LOG_LEVEL=

# The site's public address for sitemap.xml and robots.txt, e.g. https://ceyliving.lk (no trailing slash).
# Default: http://localhost:3000. Must be https:// in production (except localhost).
# SITE_URL=

# Required. PostgreSQL, as the app's data-only user ceyliving_app (DB-10). `npm run setup` fills in the local one:
# postgresql://ceyliving_app:ceyliving_dev_app@localhost:15432/ceyliving
# DATABASE_URL=

# PostgreSQL, as the schema owner ceyliving_migrator; only migrations, `npm run jobs:migrate` (the job queue's
# tables) and the seed use it. Local one:
# postgresql://ceyliving_migrator:ceyliving_dev_migrator@localhost:15432/ceyliving
# DATABASE_MIGRATION_URL=

# Required in production. Signs session cookies and email links (AU-03); at least 32 random characters.
# `npm run setup` writes a random one for local use. Generate one with: openssl rand -base64 32
# BETTER_AUTH_SECRET=

# B10: how the worker sends email: smtp (default) or resend. The web app never sends email and needs none of these.
# The worker refuses to start in production unless this is resend.
# EMAIL_DRIVER=smtp

# Development: Mailpit from `npm run db:up` (`npm run setup` writes smtp://127.0.0.1:1025); read the emails at
# http://localhost:8025, nothing leaves your computer. Without it, development skips emails. Not used in production.
# SMTP_URL=

# Production, worker only: a Resend API key (re_...), send-only and limited to the sending domain. Keep it in the
# worker's secret store, never in the web app's environment, the repository or a log.
# RESEND_API_KEY=

# The sender. Default: CeyLiving <no-reply@ceyliving.lk>. In production it must be on the domain verified with Resend
# (SPF, DKIM and DMARC set up first).
# EMAIL_FROM=

# Required in production. Cloudflare Turnstile, the "are you a person" check on sign-up, password reset and
# repeated failed sign-ins (AU-06). From the Cloudflare dashboard, Turnstile > your site. Left unset in development
# and tests, Cloudflare's published test keys are used (they always pass); production refuses those.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# B08: PayHere payments. Required in production: the merchant ID and the merchant secret for this domain (PayHere
# account > Integrations; approval can take a day). The secret never reaches the browser or the logs (PAY-02).
# Left unset in development and tests, stand-in values are used: PayHere won't accept them, but the dev-only
# "Simulate payment" button on the pay page works. Never commit real values.
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# sandbox (default) or live.
# PAYHERE_MODE=sandbox
# Optional Merchant API key (Settings > API Keys, "Automated Charging API" permission): refunds through PayHere and
# the daily reconciliation (PAY-07, PAY-08). Without it, refunds are recorded by hand and reconciliation is skipped.
# PAYHERE_APP_ID=
# PAYHERE_APP_SECRET=
# Where PayHere posts payment notifications. Default: SITE_URL/api/payments/payhere/notify. PayHere can't reach
# localhost, so for a real sandbox payment in development use a public tunnel, e.g.
# https://<name>.trycloudflare.com/api/payments/payhere/notify
# PAYHERE_NOTIFY_URL=

# B09: where uploaded photos are kept. local (default) writes to .data/uploads/ and serves them through dev-only
# routes, so no cloud account is needed; production must use r2 (the app refuses to start otherwise).
# STORAGE_DRIVER=local
# Development and tests only: another folder for the local driver. Default: .data/uploads
# LOCAL_UPLOADS_DIR=
# Cloudflare R2, all required when STORAGE_DRIVER=r2: the account id (32 characters, Cloudflare dashboard > R2), an
# R2 API token's S3 access key and secret (Object Read & Write on the two buckets only), and two buckets.
# R2_UPLOAD_BUCKET is private (originals, which can carry GPS data, and private application photos);
# R2_PUBLIC_BUCKET holds the processed photos and is connected to the image domain below. Never commit real values.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_UPLOAD_BUCKET=
# R2_PUBLIC_BUCKET=
# Where processed photos are served from, e.g. https://img.ceyliving.lk (R2_PUBLIC_BUCKET's custom domain). Also
# read at build time (browser code and the CSP), so build with the same value. Must be https:// in production.
# Default: /dev-uploads (the local driver's dev-only route).
# NEXT_PUBLIC_IMAGE_BASE_URL=

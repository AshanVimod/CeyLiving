# B14 (17.4): the backup container only (env/backup.env, chmod 600).
# The schema owner's DIRECT connection: reads every table, the job queue included.
DATABASE_BACKUP_URL=postgresql://ceyliving_migrator:CHANGE_ME@ep-example.ap-southeast-1.aws.neon.tech/ceyliving?sslmode=require
# The age PUBLIC key (age-keygen prints it). The private key stays in the password manager, never on the server.
BACKUP_AGE_RECIPIENT=age1...
# The backup bucket: separate from the uploads buckets, with a 30-day lifecycle rule.
BACKUP_BUCKET=ceyliving-backups
# An R2 API token limited to the backup bucket (Object Read & Write).
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ACL=private

# B14: the settings `next build` needs inside the image build (a BuildKit secret, never stored in the image).
# The database must be migrated and EMPTY (no seed, no demo data): pages prerendered at build time are served once
# more after every start. Locally: `CREATE DATABASE ceyliving_build` in the dev PostgreSQL, then
# `npx prisma migrate deploy` with DATABASE_MIGRATION_URL pointing at it (docs/runbook.md, section 13). The secrets are
# build-only placeholders (the build signs nothing and calls no service); SITE_URL, PAYHERE_MODE, R2_ACCOUNT_ID and
# NEXT_PUBLIC_IMAGE_BASE_URL are real: they are fixed into the image (CSP, allowed origins, image addresses).
DATABASE_URL=postgresql://ceyliving_app:ceyliving_dev_app@host.docker.internal:15432/ceyliving_build
SITE_URL=http://localhost:3000
PAYHERE_MODE=sandbox
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=00000000000000000000000000000000
NEXT_PUBLIC_IMAGE_BASE_URL=https://img.example.invalid
BETTER_AUTH_SECRET=build-only-placeholder-not-a-secret-0123456789
CACHE_REFRESH_SECRET=build-only-placeholder-not-a-secret-0123456789
TURNSTILE_SITE_KEY=build-only-site-key
TURNSTILE_SECRET_KEY=build-only-not-a-secret
PAYHERE_MERCHANT_ID=1000000
PAYHERE_MERCHANT_SECRET=build-only-not-a-secret
R2_ACCESS_KEY_ID=build-only-access-key
R2_SECRET_ACCESS_KEY=build-only-not-a-secret
R2_UPLOAD_BUCKET=build-uploads
R2_PUBLIC_BUCKET=build-images

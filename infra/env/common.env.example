# B14: settings both the web app and the worker read (copy to /opt/ceyliving/<environment>/env/common.env, chmod 600).
# Every key is described in .env.example; lib/env.ts checks them when each process starts. Generate each secret with
# `openssl rand -base64 32`, new for every environment, and keep a copy in the password manager.
SITE_URL=https://staging.example.lk
LOG_LEVEL=info
# DB-10: the app's data-only user. Neon: the POOLED connection string.
DATABASE_URL=postgresql://ceyliving_app:CHANGE_ME@ep-example-pooler.ap-southeast-1.aws.neon.tech/ceyliving?sslmode=require
# Shared by web and worker (the worker asks the web app to refresh its cached catalogue).
CACHE_REFRESH_SECRET=
# lib/env.ts requires these in every production process, the worker included.
BETTER_AUTH_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# B09: R2 (the web app signs uploads, the worker processes photos).
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_UPLOAD_BUCKET=
R2_PUBLIC_BUCKET=
NEXT_PUBLIC_IMAGE_BASE_URL=https://img.staging.example.lk

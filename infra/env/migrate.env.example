# B14: the one-off migrate container only (env/migrate.env, chmod 600). DB-10: the schema owner. Neon: the DIRECT
# (unpooled) connection string; migrations need a session, not the pooler.
DATABASE_MIGRATION_URL=postgresql://ceyliving_migrator:CHANGE_ME@ep-example.ap-southeast-1.aws.neon.tech/ceyliving?sslmode=require

# B14: web app only (env/web.env, chmod 600). The worker never gets these keys.
# B11: encrypts sellers' bank account numbers. Keep it apart from the backups (they hold the encrypted values).
FIELD_ENCRYPTION_KEY=
# B12: IP hashes and sign-in limits.
IP_HASH_KEY=
# B08: optional Merchant API key for refunds through PayHere.
# PAYHERE_APP_ID=
# PAYHERE_APP_SECRET=

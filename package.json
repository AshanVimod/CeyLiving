{
  "name": "ceyliving",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "setup": "node scripts/setup.mjs",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.12 <23",
    "npm": ">=10"
  },
  "dependencies": {
    "next": "16.4.2",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "husky": "9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs,js}": [
      "node node_modules/prettier/bin/prettier.cjs --write",
      "node node_modules/eslint/bin/eslint.js --fix"
    ],
    "*.{json,css,md,yml,yaml}": "node node_modules/prettier/bin/prettier.cjs --write"
  }
}

{
  "name": "ceyliving",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --conditions=react-server --env-file-if-exists=.env.local worker/index.ts",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "setup": "node scripts/setup.mjs",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:up": "docker compose -f infra/docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.dev.yml down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run jobs:migrate && npm run db:seed",
    "jobs:migrate": "tsx --env-file-if-exists=.env.local worker/migrate-cli.ts"
  },
  "engines": {
    "node": ">=22.12 <23",
    "npm": ">=10"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.10",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.10",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testcontainers/postgresql": "12.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "husky": "9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "server-only": "0.0.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs,js}": [
      "node node_modules/prettier/bin/prettier.cjs --write",
      "node node_modules/eslint/bin/eslint.js --fix"
    ],
    "*.{json,css,md,yml,yaml}": "node node_modules/prettier/bin/prettier.cjs --write"
  },
  "overrides": {
    "@better-auth/core": "1.7.10",
    "better-call": "1.4.2",
    "@better-fetch/fetch": "1.3.2",
    "@peculiar/asn1-android": "2.11.0",
    "@peculiar/asn1-cms": "2.11.0",
    "@peculiar/asn1-csr": "2.11.0",
    "@peculiar/asn1-ecc": "2.11.0",
    "@peculiar/asn1-pfx": "2.11.0",
    "@peculiar/asn1-pkcs8": "2.11.0",
    "@peculiar/asn1-pkcs9": "2.11.0",
    "@peculiar/asn1-rsa": "2.11.0",
    "@peculiar/asn1-schema": "2.11.0",
    "@peculiar/asn1-x509": "2.11.0",
    "@peculiar/asn1-x509-attr": "2.11.0",
    "cron-parser": "5.10.2",
    "@opentelemetry/api": "1.9.1"
  }
}

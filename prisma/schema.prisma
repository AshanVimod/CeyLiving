// CeyLiving database schema (backend plan section 7, ADR 0001).
// Models match lib/types.ts; repositories map rows to those types (BE-01). Tables and columns are snake_case (DB-01).
// Money is integer cents (DB-03); times are timestamptz (DB-03). CHECK constraints and table rights that Prisma
// can't express live in the migrations' SQL (DB-07, DB-09, DB-10).

generator client {
  provider        = "prisma-client"
  output          = "../lib/server/db/generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums (DB-03: database enums matching lib/types.ts) ----------

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum PostingRestriction {
  NONE
  MUTED
  BANNED
}

enum CategoryGroup {
  MODERN
  TRADITIONAL
}

enum ApplicationStatus {
  PENDING
  NEEDS_CHANGES
  APPROVED
  REJECTED
  WITHDRAWN
}

/// B09 (backend plan 11.1): what an upload is for. Only an upload of the matching purpose can be attached.
enum UploadPurpose {
  PRODUCT_IMAGE
  SHOP_LOGO
  SHOP_BANNER
  APPLICATION_PHOTO
}

/// B09: PENDING until image.process checks and converts it (READY) or refuses it (REJECTED).
enum UploadStatus {
  PENDING
  READY
  REJECTED
}

/// B10: where an email stands. Only QUEUED rows still hold the address (account.deleted) and the template data.
enum EmailStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum BusinessType {
  INDIVIDUAL
  REGISTERED_BUSINESS
}

enum ShopStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  ARCHIVED
  REMOVED
}

enum ProductType {
  READY_TO_SHIP
  MADE_TO_ORDER
}

enum Style {
  MODERN
  TRADITIONAL
  MINIMAL
  COLOURFUL
  RUSTIC
  CULTURAL
}

enum CustomizationKind {
  TEXT
  SELECT
}

enum SellerOrderStatus {
  /// B07: created at checkout, waiting for payment. Sellers never see it (BR-06, backend plan 9.1).
  PENDING_PAYMENT
  NEW
  ACCEPTED
  IN_PROGRESS
  DISPATCHED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ContentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum AnswerAuthorRole {
  SELLER
  ADMIN
}

enum ReportTargetType {
  PRODUCT
  SHOP
  REVIEW
  QUESTION
  ANSWER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum VoteTargetType {
  REVIEW
  QUESTION
}

/// B07: whether the customer has paid for an order. PENDING orders expire at expires_at (BR-06).
enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  /// B08 (BR-18): every seller order of a paid order was refunded.
  REFUNDED
  /// B08 (BR-18): some of it was refunded.
  PARTIALLY_REFUNDED
}

/// B08 (PAY-05): PayHere's status for one payment (status_code 2, 0, -1, -2, -3).
enum ProviderPaymentStatus {
  SUCCESS
  PENDING
  CANCELLED
  FAILED
  CHARGEDBACK
}

/// B08 (PAY-07): a refund is PENDING while PayHere is asked, then SUCCEEDED or FAILED.
enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum RefundMethod {
  PAYHERE
  MANUAL
}

enum PayoutStatus {
  PENDING
  SCHEDULED
  PAID
  FAILED
}

enum CustomRequestStatus {
  OPEN
  QUOTED
  ACCEPTED
  DECLINED
  EXPIRED
}

// ---------- People ----------

/// Users are never hard-deleted: FR-17 anonymises them and keeps order records (deleted_at marks it).
model User {
  id                 String             @id
  name               String
  /// Stored lowercase (CHECK in the migration), so this unique index is case-insensitive.
  email              String             @unique
  phone              String?
  role               Role
  emailVerified      Boolean            @map("email_verified")
  postingRestriction PostingRestriction @map("posting_restriction")
  mutedUntil         DateTime?          @map("muted_until") @db.Timestamptz(3)
  restrictionReason  String?            @map("restriction_reason")
  createdAt          DateTime           @map("created_at") @db.Timestamptz(3)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(3)
  /// B05a: Better Auth keeps these up to date; the app never shows a profile image yet.
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  image              String?
  /// B05b (AU-02): an authenticator app is set up and confirmed. Better Auth sets it; sign-in then asks for a code.
  twoFactorEnabled   Boolean            @default(false) @map("two_factor_enabled")

  applications        SellerApplication[] @relation("applicant")
  decidedApplications SellerApplication[] @relation("decider")
  shops               Shop[]
  addresses           Address[]
  orders              Order[]
  reviews             Review[]
  questions           ProductQuestion[]
  answers             ProductAnswer[]
  reports             Report[]            @relation("reporter")
  resolvedReports     Report[]            @relation("resolver")
  auditEntries        AuditLogEntry[]
  notifications       Notification[]
  customRequests      CustomRequest[]
  helpfulVotes        HelpfulVote[]
  rateEvents          RateEvent[]
  sessions            Session[]
  accounts            Account[]
  twoFactor           TwoFactor?
  passkeys            Passkey[]
  refundsCreated      Refund[]
  uploads             Upload[]
  emailDeliveries     EmailDelivery[]

  @@index([role])
  /// B06 (users.liftExpiredMutes): finds mutes that have run out without reading every user.
  @@index([mutedUntil], map: "users_muted_until_idx", where: raw("posting_restriction = 'MUTED'::\"PostingRestriction\""))
  @@map("users")
}

// ---------- Sign-in (Better Auth, B05a; backend plan AU-01 to AU-11) ----------

/// One signed-in browser. The token is what the HttpOnly cookie carries (AU-03).
model Session {
  id        String   @id
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// B05b (AU-02): this session was opened with two steps (a password and an authenticator code or recovery code,
  /// or a passkey). Set only by the server when the session is created; sellers and admins need it.
  twoStep   Boolean  @default(false) @map("two_step")

  /// A user's sessions end with the user row (users are never hard-deleted; FR-17 anonymises them).
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// How a user signs in. For email and password, providerId is "credential" and `password` holds Better Auth's
/// hash (never written or logged by the app).
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Single-use email tokens (verify email, reset password); Better Auth deletes a row once it is used.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

/// B05b (AU-02): a user's authenticator app. `secret` is encrypted with BETTER_AUTH_SECRET; `backupCodes` holds
/// only keyed hashes of the recovery codes (lib/server/better-auth.ts), so the codes themselves are never stored.
model TwoFactor {
  id                      String    @id
  userId                  String    @unique @map("user_id")
  secret                  String
  backupCodes             String    @map("backup_codes")
  /// False until the person enters a first code from the app; until then sign-in doesn't ask for one.
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factors")
}

/// B05b (AU-02): a passkey (WebAuthn credential). Only the public key is stored; the private key never leaves the
/// person's device.
model Passkey {
  id           String    @id
  name         String?
  publicKey    String    @map("public_key")
  userId       String    @map("user_id")
  credentialID String    @unique @map("credential_id")
  counter      Int
  deviceType   String    @map("device_type")
  backedUp     Boolean   @map("backed_up")
  transports   String?
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(3)
  aaguid       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

/// AU-06 attempt counters, shared by every app instance because they live in the database.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

/// FR-2a: an application to open a shop.
model SellerApplication {
  id                String            @id
  userId            String            @map("user_id")
  applicantName     String            @map("applicant_name")
  phone             String
  businessType      BusinessType      @map("business_type")
  businessRegNo     String?           @map("business_reg_no")
  shopName          String            @map("shop_name")
  craft             String
  /// 1 to 6 category slugs (CHECK in the migration).
  categorySlugs     String[]          @map("category_slugs")
  addressLine1      String            @map("address_line1")
  addressLine2      String?           @map("address_line2")
  addressCity       String            @map("address_city")
  addressDistrict   String            @map("address_district")
  addressPostalCode String?           @map("address_postal_code")
  story             String
  /// B09: no longer written; kept for the previous app version and dropped in a later contract step.
  workPhotoUrls     String[]          @map("work_photo_urls")
  /// B09: 3 to 6 photo ids (upl_… uploads, or Unsplash ids from before B09), in order.
  workPhotoIds      String[]          @default([]) @map("work_photo_ids")
  socialUrl         String?           @map("social_url")
  acceptedTermsAt   DateTime          @map("accepted_terms_at") @db.Timestamptz(3)
  status            ApplicationStatus
  adminNote         String?           @map("admin_note")
  decidedById       String?           @map("decided_by_id")
  decidedAt         DateTime?         @map("decided_at") @db.Timestamptz(3)
  createdAt         DateTime          @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @map("updated_at") @db.Timestamptz(3)

  user      User  @relation("applicant", fields: [userId], references: [id], onDelete: Restrict)
  decidedBy User? @relation("decider", fields: [decidedById], references: [id], onDelete: Restrict)

  /// RULE-A1: one open application per person, enforced by the database.
  @@unique([userId], map: "seller_applications_one_open_per_user", where: raw("status = ANY (ARRAY['PENDING'::\"ApplicationStatus\", 'NEEDS_CHANGES'::\"ApplicationStatus\"])"))
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([decidedById])
  @@map("seller_applications")
}

model Address {
  id            String  @id
  userId        String  @map("user_id")
  label         String
  recipientName String  @map("recipient_name")
  line1         String
  line2         String?
  city          String
  district      String
  postalCode    String? @map("postal_code")
  phone         String

  /// FR-17: an account's saved addresses go when the account is deleted.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Notification {
  id        String    @id
  userId    String    @map("user_id")
  type      String
  title     String
  href      String
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

/// SEC-A9 / DB-09: append-only. The app role may INSERT and SELECT only (rights in the migration).
model AuditLogEntry {
  id         String   @id
  /// NULL: the worker did it (a scheduled job, B06); the reason names the job.
  actorId    String?  @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  reason     String?
  before     Json?
  after      Json?
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId])
  @@index([createdAt])
  @@index([actorId])
  @@map("audit_log")
}

/// SEC-A6: one posting attempt; old rows are pruned.
model RateEvent {
  id     BigInt   @id @default(autoincrement())
  userId String   @map("user_id")
  kind   String
  at     DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, at])
  @@index([at])
  @@map("rate_events")
}

// ---------- Catalogue ----------

model Category {
  slug          String                   @id
  name          String
  group         CategoryGroup
  blurb         String
  subcategories String[]
  photoId       String                   @map("photo_id")
  photoAlt      String                   @map("photo_alt")
  sinhala       String?
  sortOrder     Int                      @map("sort_order")
  /// Generated by the database from name and Sinhala name (B04b migration); never written by the app.
  searchVector  Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")

  products Product[]

  @@map("categories")
}

model Shop {
  id                  String                   @id
  ownerId             String                   @map("owner_id")
  slug                String                   @unique
  name                String
  ownerName           String                   @map("owner_name")
  district            String
  craft               String
  story               String
  quote               String
  since               Int
  isVerified          Boolean                  @map("is_verified")
  logoPhotoId         String                   @map("logo_photo_id")
  logoAlt             String                   @map("logo_alt")
  bannerPhotoId       String                   @map("banner_photo_id")
  bannerAlt           String                   @map("banner_alt")
  portraitPhotoId     String?                  @map("portrait_photo_id")
  portraitAlt         String?                  @map("portrait_alt")
  dispatchDays        String                   @map("dispatch_days")
  returnPolicy        String                   @map("return_policy")
  status              ShopStatus
  statusReason        String?                  @map("status_reason")
  /// Replaced by ShopPayoutAccount (B11). Still written so an older app version works after a rollback; nothing reads it.
  payoutAccountMasked String?                  @map("payout_account_masked")
  /// B08 (PAY-05): set by a chargeback; while set, no payout is made or marked paid. An admin releases it (audited).
  payoutHoldReason    String?                  @map("payout_hold_reason")
  payoutHeldAt        DateTime?                @map("payout_held_at") @db.Timestamptz(3)
  createdAt           DateTime                 @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                 @map("updated_at") @db.Timestamptz(3)
  /// Generated by the database from the name (B04b migration); never written by the app.
  searchVector        Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")

  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  products       Product[]
  sellerOrders   SellerOrder[]
  reviews        Review[]
  questions      ProductQuestion[]
  payouts        Payout[]
  customRequests CustomRequest[]
  payoutAccount  ShopPayoutAccount?

  /// RULE-S1: one open shop per owner (a closed shop's owner may open another later).
  @@unique([ownerId], map: "shops_one_open_per_owner", where: raw("status <> 'CLOSED'"))
  @@index([ownerId])
  @@index([status])
  @@index([searchVector], map: "shops_search_vector_idx", type: Gin)
  @@map("shops")
}

/// B11 (12.4, G-09): the bank details for a shop's transfers. The account number is stored only encrypted (CHECK in the
/// migration); only the reveal and the re-encrypt script ever select it.
model ShopPayoutAccount {
  shopId           String    @id @map("shop_id")
  bankName         String    @map("bank_name")
  branch           String
  accountName      String    @map("account_name")
  accountNumberEnc String    @map("account_number_enc")
  accountLast4     String    @map("account_last4")
  /// Set the first time a transfer to this account is recorded; cleared when the account is replaced.
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@map("shop_payout_accounts")
}

model Product {
  id              String                   @id
  shopId          String                   @map("shop_id")
  categorySlug    String                   @map("category_slug")
  subcategory     String
  slug            String                   @unique
  title           String
  description     String
  /// Material slugs from lib/types.ts (CHECK in the migration).
  materials       String[]
  materialNote    String                   @map("material_note")
  styles          Style[]
  tags            String[]
  type            ProductType
  processingDays  Int?                     @map("processing_days")
  isCustomizable  Boolean                  @map("is_customizable")
  isHeritage      Boolean                  @map("is_heritage")
  isEcoFriendly   Boolean                  @map("is_eco_friendly")
  featuredRank    Int?                     @map("featured_rank")
  publishedAt     DateTime                 @map("published_at") @db.Date
  dimensions      String
  care            String
  status          ProductStatus
  rejectionReason String?                  @map("rejection_reason")
  createdAt       DateTime                 @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                 @map("updated_at") @db.Timestamptz(3)
  /// Generated by the database: title, tags, materials, description (B04b migration); never written by the app.
  searchVector    Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")

  shop          Shop                 @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category      Category             @relation(fields: [categorySlug], references: [slug], onDelete: Restrict)
  images        ProductImage[]
  variants      ProductVariant[]
  customization CustomizationField[]
  orderItems    OrderItem[]
  reviews       Review[]
  questions     ProductQuestion[]

  @@index([shopId, status])
  @@index([status, publishedAt])
  @@index([categorySlug])
  /// B04b search: full-text over search_vector, typo-tolerant suggestions over title.
  @@index([searchVector], map: "products_search_vector_idx", type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], map: "products_title_trgm_idx", type: Gin)
  @@map("products")
}

/// RULE-P3: 1 to 8 photos per item, in order.
model ProductImage {
  productId String @map("product_id")
  position  Int
  photoId   String @map("photo_id")
  alt       String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, position])
  @@map("product_images")
}

model ProductVariant {
  productId           String @map("product_id")
  sku                 String
  position            Int
  label               String
  priceCents          Int    @map("price_cents")
  compareAtPriceCents Int?   @map("compare_at_price_cents")
  stock               Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, sku])
  @@unique([productId, position])
  @@map("product_variants")
}

model CustomizationField {
  productId  String            @map("product_id")
  key        String
  position   Int
  label      String
  kind       CustomizationKind
  options    String[]
  maxLength  Int               @map("max_length")
  isRequired Boolean           @map("is_required")
  helper     String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, key])
  @@unique([productId, position])
  @@map("customization_fields")
}

// ---------- Orders and money ----------

model Order {
  id              String        @id
  orderNumber     String        @unique @map("order_number")
  customerId      String        @map("customer_id")
  /// Snapshot taken at checkout; never re-read from the address book.
  shippingAddress Json          @map("shipping_address")
  subtotalCents   Int           @map("subtotal_cents")
  shippingCents   Int           @map("shipping_cents")
  totalCents      Int           @map("total_cents")
  placedAt        DateTime      @map("placed_at") @db.Timestamptz(3)
  /// B07: PENDING until the payment notification (B08); EXPIRED when unpaid at expiresAt. No default: every insert
  /// says which.
  paymentStatus   PaymentStatus @map("payment_status")
  /// B07: made by the checkout page when it opens; the same key twice returns the same order.
  idempotencyKey  String?       @map("idempotency_key")
  /// B07 (BR-06): an unpaid order is cancelled and its stock returned at this time (orders.expireUnpaid).
  expiresAt       DateTime?     @map("expires_at") @db.Timestamptz(3)
  /// B08: when the verified PayHere notification marked it PAID (PAY-03). Set for every PAID order (CHECK).
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(3)

  customer     User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sellerOrders SellerOrder[]
  payments     Payment[]

  @@unique([customerId, idempotencyKey])
  @@index([customerId, placedAt])
  @@index([paidAt], map: "orders_paid_at_idx", where: raw("paid_at IS NOT NULL"))
  @@map("orders")
}

model SellerOrder {
  id               String            @id
  orderId          String            @map("order_id")
  shopId           String            @map("shop_id")
  status           SellerOrderStatus
  subtotalCents    Int               @map("subtotal_cents")
  shippingCents    Int               @map("shipping_cents")
  courierName      String?           @map("courier_name")
  trackingRef      String?           @map("tracking_ref")
  cancelReason     String?           @map("cancel_reason")
  acceptedAt       DateTime?         @map("accepted_at") @db.Timestamptz(3)
  dispatchedAt     DateTime?         @map("dispatched_at") @db.Timestamptz(3)
  completedAt      DateTime?         @map("completed_at") @db.Timestamptz(3)
  /// BR-08 (B06): a NEW order not accepted by then is cancelled by orders.autoCancelUnaccepted. Set when the order
  /// is paid (B08); NULL means no deadline.
  acceptDeadlineAt DateTime?         @map("accept_deadline_at") @db.Timestamptz(3)
  updatedAt        DateTime          @map("updated_at") @db.Timestamptz(3)
  /// BR-11: each seller order is paid out once.
  payoutId         String?           @map("payout_id")

  order   Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shop    Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  payout  Payout?     @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  items   OrderItem[]
  refunds Refund[]

  @@index([orderId])
  @@index([shopId, status])
  @@index([shopId, updatedAt])
  @@index([payoutId])
  @@index([status, completedAt])
  @@index([status, acceptDeadlineAt])
  @@index([status, dispatchedAt])
  @@map("seller_orders")
}

model OrderItem {
  id             String  @id
  sellerOrderId  String  @map("seller_order_id")
  productId      String  @map("product_id")
  variantSku     String  @map("variant_sku")
  productTitle   String  @map("product_title")
  variantLabel   String  @map("variant_label")
  unitPriceCents Int     @map("unit_price_cents")
  quantity       Int
  /// B07 (BR-16): what the customer asked for, by the field's label at checkout; checked then. NULL when none.
  customization  Json?
  /// B07 (BR-06): whether checkout took this line's quantity from stock, so an expiry returns exactly that.
  stockReserved  Boolean @default(false) @map("stock_reserved")

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  review      Review?

  @@index([sellerOrderId])
  @@index([productId])
  @@map("order_items")
}

/// BR-10 / BR-11: one weekly statement per shop. Its seller orders point to it (seller_orders.payout_id).
model Payout {
  id              String       @id
  shopId          String       @map("shop_id")
  periodStart     DateTime     @map("period_start") @db.Timestamptz(3)
  periodEnd       DateTime     @map("period_end") @db.Timestamptz(3)
  grossCents      Int          @map("gross_cents")
  commissionCents Int          @map("commission_cents")
  refundsCents    Int          @map("refunds_cents")
  netCents        Int          @map("net_cents")
  status          PayoutStatus
  paidAt          DateTime?    @map("paid_at") @db.Timestamptz(3)
  reference       String?
  createdAt       DateTime     @map("created_at") @db.Timestamptz(3)

  shop            Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  sellerOrders    SellerOrder[]
  deductedRefunds Refund[]

  @@index([shopId, createdAt])
  @@index([status])
  @@map("payouts")
}

/// B08 (PAY-03, PAY-04): one PayHere payment, recorded from its verified notification. A repeated notification for
/// the same payment finds this row (unique provider + provider_payment_id) and changes nothing. Card details are
/// never stored (PAY-01): raw keeps only the allow-listed notification fields.
model Payment {
  id                String                @id
  orderId           String                @map("order_id")
  provider          String
  providerPaymentId String                @map("provider_payment_id")
  amountCents       Int                   @map("amount_cents")
  currency          String
  status            ProviderPaymentStatus
  statusCode        Int                   @map("status_code") @db.SmallInt
  method            String?
  raw               Json
  /// BR-18: the part of this payment refunded so far (CHECK 0..amount_cents).
  refundedCents     Int                   @default(0) @map("refunded_cents")
  /// PAY-06: set when the money can't go to the order (it expired, or another payment paid it first). An admin
  /// refunds it; the order is never re-opened.
  needsRefundReason String?               @map("needs_refund_reason")
  verifiedAt        DateTime              @map("verified_at") @db.Timestamptz(3)
  createdAt         DateTime              @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @map("updated_at") @db.Timestamptz(3)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([createdAt], map: "payments_needs_refund_idx", where: raw("needs_refund_reason IS NOT NULL"))
  @@map("payments")
}

/// B08 (PAY-07, BR-18): money given back by an admin, for one seller order or (seller_order_id NULL) for a whole
/// payment that couldn't be used (PAY-06). Partial unique indexes in the migration stop a second live refund.
model Refund {
  id               String       @id
  paymentId        String       @map("payment_id")
  sellerOrderId    String?      @map("seller_order_id")
  amountCents      Int          @map("amount_cents")
  /// BR-18: what the seller gives back from a later payout (0 when the seller was never paid for it).
  clawbackCents    Int          @map("clawback_cents")
  reason           String
  method           RefundMethod
  status           RefundStatus
  /// PayHere's refund number, or the admin's bank reference for a manual refund.
  providerRef      String?      @map("provider_ref")
  /// Why PayHere refused it (FAILED only).
  failure          String?
  createdById      String       @map("created_by_id")
  createdAt        DateTime     @map("created_at") @db.Timestamptz(3)
  settledAt        DateTime?    @map("settled_at") @db.Timestamptz(3)
  /// BR-18: the payout this refund's clawback was taken from. NULL while it is still owed.
  deductedPayoutId String?      @map("deducted_payout_id")

  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  sellerOrder    SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  deductedPayout Payout?      @relation(fields: [deductedPayoutId], references: [id], onDelete: Restrict)

  @@unique([sellerOrderId], map: "refunds_one_live_per_seller_order", where: raw("seller_order_id IS NOT NULL AND status <> 'FAILED'"))
  @@unique([paymentId], map: "refunds_one_live_per_whole_payment", where: raw("seller_order_id IS NULL AND status <> 'FAILED'"))
  @@index([paymentId])
  @@index([sellerOrderId])
  @@index([createdById])
  @@index([deductedPayoutId])
  @@map("refunds")
}

/// FR-14: a customer asks a maker for something made to measure.
model CustomRequest {
  id              String              @id
  customerId      String              @map("customer_id")
  customerName    String              @map("customer_name")
  shopId          String              @map("shop_id")
  message         String
  budgetCents     Int?                @map("budget_cents")
  status          CustomRequestStatus
  quotePriceCents Int?                @map("quote_price_cents")
  quoteDays       Int?                @map("quote_days")
  quoteMessage    String?             @map("quote_message")
  quotedAt        DateTime?           @map("quoted_at") @db.Timestamptz(3)
  declineReason   String?             @map("decline_reason")
  createdAt       DateTime            @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @map("updated_at") @db.Timestamptz(3)

  customer User @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shop     Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@index([customerId, updatedAt])
  @@index([shopId, updatedAt])
  @@index([status, updatedAt])
  @@map("custom_requests")
}

// ---------- Community ----------

model Review {
  id              String        @id
  productId       String        @map("product_id")
  shopId          String        @map("shop_id")
  /// RULE-R1: one review per delivered order item.
  orderItemId     String?       @unique @map("order_item_id")
  authorId        String        @map("author_id")
  authorName      String        @map("author_name")
  rating          Int
  comment         String?
  status          ContentStatus
  statusReason    String?       @map("status_reason")
  sellerReply     String?       @map("seller_reply")
  sellerRepliedAt DateTime?     @map("seller_replied_at") @db.Timestamptz(3)
  ceylivingReply  String?       @map("ceyliving_reply")
  createdAt       DateTime      @map("created_at") @db.Timestamptz(3)
  editedAt        DateTime?     @map("edited_at") @db.Timestamptz(3)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  shop      Shop       @relation(fields: [shopId], references: [id], onDelete: Restrict)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([productId, status])
  @@index([shopId, createdAt])
  @@index([authorId])
  @@map("reviews")
}

model ProductQuestion {
  id           String        @id
  productId    String        @map("product_id")
  shopId       String        @map("shop_id")
  authorId     String        @map("author_id")
  authorName   String        @map("author_name")
  body         String
  status       ContentStatus
  statusReason String?       @map("status_reason")
  createdAt    DateTime      @map("created_at") @db.Timestamptz(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  shop    Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  author  User            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  answers ProductAnswer[]

  @@index([productId, status])
  @@index([shopId, createdAt])
  @@index([authorId])
  @@map("product_questions")
}

model ProductAnswer {
  id           String           @id
  questionId   String           @map("question_id")
  authorId     String           @map("author_id")
  authorRole   AnswerAuthorRole @map("author_role")
  body         String
  status       ContentStatus
  statusReason String?          @map("status_reason")
  createdAt    DateTime         @map("created_at") @db.Timestamptz(3)

  question ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  author   User            @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([questionId, createdAt])
  @@index([authorId])
  @@map("product_answers")
}

/// FR-8. The target can be any of five kinds, so target_id has no foreign key (checked in the service).
model Report {
  id           String           @id
  reporterId   String           @map("reporter_id")
  targetType   ReportTargetType @map("target_type")
  targetId     String           @map("target_id")
  reason       String
  details      String?
  status       ReportStatus
  resolvedById String?          @map("resolved_by_id")
  resolution   String?
  createdAt    DateTime         @map("created_at") @db.Timestamptz(3)

  reporter   User  @relation("reporter", fields: [reporterId], references: [id], onDelete: Restrict)
  resolvedBy User? @relation("resolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  /// FR-8: one open report per person per target.
  @@unique([reporterId, targetType, targetId], map: "reports_one_open_per_reporter", where: raw("status = 'OPEN'"))
  @@index([targetType, targetId, status])
  @@index([status, createdAt])
  @@index([reporterId])
  @@index([resolvedById])
  @@map("reports")
}

/// FR-19: one vote per person per review or question. The target has no foreign key (two possible tables).
model HelpfulVote {
  userId     String         @map("user_id")
  targetType VoteTargetType @map("target_type")
  targetId   String         @map("target_id")
  createdAt  DateTime       @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("helpful_votes")
}

/// B09 (SEC-07, backend plan 11.1): a photo someone uploaded. The id (upl_…) is also the photo id stored on products,
/// shops and applications. CHECKs in the migration: declared type JPEG/PNG/WebP, 1 byte to 8 MB, READY has its size
/// and times, REJECTED has a reason.
model Upload {
  id           String        @id
  ownerId      String        @map("owner_id")
  /// u/<userId>/<uuid>: the original in the private bucket.
  storageKey   String        @unique @map("storage_key")
  purpose      UploadPurpose
  contentType  String        @map("content_type")
  sizeBytes    Int           @map("size_bytes")
  status       UploadStatus  @default(PENDING)
  rejectReason String?       @map("reject_reason")
  width        Int?
  height       Int?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedAt  DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  processedAt  DateTime?     @map("processed_at") @db.Timestamptz(3)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, createdAt])
  @@index([createdAt], map: "uploads_pending_created_at_idx", where: raw("status = 'PENDING'::\"UploadStatus\""))
  @@map("uploads")
}

/// B10 (backend plan 11.2): one row per email. The unique dedupe key makes an event queued twice send once (JOB-03),
/// and email.send records the provider's message id here. The address and template data are cleared once the row
/// leaves QUEUED (a CHECK in the migration enforces it).
model EmailDelivery {
  id                String      @id
  /// <template>:<what it is about>, e.g. order.dispatched:so_123.
  dedupeKey         String      @unique @map("dedupe_key")
  template          String
  userId            String      @map("user_id")
  /// Only for account.deleted: the address as it was before the account was anonymised.
  toAddress         String?     @map("to_address")
  data              Json?
  status            EmailStatus @default(QUEUED)
  provider          String?
  providerMessageId String?     @map("provider_message_id")
  attempts          Int         @default(0)
  /// A short code (e.g. resend_422, smtp_550), never the provider's message.
  lastError         String?     @map("last_error")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  lastAttemptAt     DateTime?   @map("last_attempt_at") @db.Timestamptz(3)
  sentAt            DateTime?   @map("sent_at") @db.Timestamptz(3)
  /// email.watch told the admins about this row (each problem alerts once).
  alertedAt         DateTime?   @map("alerted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([createdAt], map: "email_deliveries_queued_created_at_idx", where: raw("status = 'QUEUED'::\"EmailStatus\""))
  @@map("email_deliveries")
}
